spring.application.name=Eq13Tessera

# --- Datasource ---
# Copia este archivo como "application.properties" y pon tus datos reales.
# El archivo application.properties NO debe subirse a GitHub (va en .gitignore).
spring.datasource.url=jdbc:mysql://localhost:3306/tessera_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=tessera_user
spring.datasource.password=CAMBIA_ESTA_CONTRASENA
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- JPA / Hibernate ---
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# --- Flyway ---
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true

# --- JWT ---
jwt.secret=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_UNICA
jwt.expiration=86400000

# --- Correo (Postfix en el VPS) ---
spring.mail.host=localhost
spring.mail.port=25
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
mail.remitente=no-reply@tessera.com

# --- SMS y WhatsApp (Twilio) ---
twilio.account-sid=TU_ACCOUNT_SID
twilio.auth-token=TU_AUTH_TOKEN
twilio.sms-from=TU_NUMERO_TWILIO
twilio.whatsapp-from=whatsapp:+14155238886
