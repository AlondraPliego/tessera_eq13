meta {
  name: 01 - Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Usuario Prueba",
    "email": "prueba@tessera.com",
    "password": "Prueba123!",
    "rolNombre": "CLIENTE",
    "nombreUsuario": "pruebaCliente"
  }
}

vars:pre-request {
  baseUrl: https://tessera.rocks
}

assert {
  res.status: eq 201
}
