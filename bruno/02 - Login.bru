meta {
  name: 02 - Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "prueba@tessera.com",
    "password": "Prueba123!"
  }
}

vars:pre-request {
  baseUrl: https://tessera.rocks
}

assert {
  res.status: eq 200
}

script:post-response {
  const data = res.getBody();
  bru.setEnvVar("token", data.token);
}
