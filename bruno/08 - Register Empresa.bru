meta {
  name: 08 - Register Empresa
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Empresa Prueba",
    "email": "empresa@tessera.com",
    "password": "Empresa123!",
    "rolNombre": "EMPRESA",
    "nombreUsuario": "empresaPrueba"
  }
}

assert {
  res.status: eq 201
}
