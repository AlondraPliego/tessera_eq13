meta {
  name: 09 - Login Empresa
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "empresa@tessera.com",
    "password": "Empresa123!"
  }
}

vars:pre-request {
  baseUrl: https://tessera.rocks
}

assert {
  res.status: eq 200
}

script:post-response {
  const data = res.getBody();
  bru.setEnvVar("tokenEmpresa", data.token);
}
