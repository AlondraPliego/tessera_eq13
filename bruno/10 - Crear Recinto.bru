meta {
  name: 10 - Crear Recinto
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/recintos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenEmpresa}}
}

body:json {
  {
    "nombre": "Teatro Tessera",
    "direccion": "Av. Principal 123, Puerto Escondido"
  }
}

vars:pre-request {
  baseUrl: https://tessera.rocks
}

assert {
  res.status: eq 201
}

script:post-response {
  const data = res.getBody();
  bru.setEnvVar("recintoId", data.id);
}
